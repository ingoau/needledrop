# Where your music lives on the host, and where it appears in the container.
# Mount it at the same path as on the host if an existing beets library.db
# refers to host paths.
MUSIC_PATH=./music
# MUSIC_MOUNT=/music

# Beets config folder (config.yaml + library.db). Empty = Needledrop default.
BEETS_PATH=./beets

# Override the layout under MUSIC_MOUNT if you need to.
# INBOX_DIR=/music/inbox
# DOWNLOADING_DIR=/music/.downloading
# LIBRARY_DIR=/music/library

# User/group that owns your music files.
# PUID=1000
# PGID=1000

# wrapper-v2
# WRAPPER_NETWORK=wrapper-v2_default
# WRAPPER_URL=http://wrapper:80
# WRAPPER_DECRYPT_HOST=wrapper
# WRAPPER_DECRYPT_PORT=10020

# AUTO_APPLY=true
# TAGGER_BUFFER_SECONDS=30
# AUDIO_POLICY=prefer-lossless   # lossless-only | aac-only
# PORT=8080
# BIND_ADDRESS=127.0.0.1
